  <!-- Shaders: the DXSDK's fxc compiles each entry point of render.hlsl to a bytecode header in $(IntDir)shaders,
       so the game needs no D3DX at run time. -->
  <ItemGroup>
    <CustomBuild Include="src\gfx\d3d9\shaders\render.hlsl">
      <Message>Compiling shaders: %(Filename)%(Extension)</Message>
      <Command>if not exist "$(IntDir)shaders" mkdir "$(IntDir)shaders"
"$(DXSDKPath)Utilities\bin\x86\fxc.exe" /nologo /T vs_2_0 /E VSMain /Vn g_vsMain /Fh "$(IntDir)shaders\render_vs.h" "%(FullPath)" || exit /b 1
"$(DXSDKPath)Utilities\bin\x86\fxc.exe" /nologo /T vs_2_0 /E VSMesh /Vn g_vsMesh /Fh "$(IntDir)shaders\render_vs_mesh.h" "%(FullPath)" || exit /b 1
"$(DXSDKPath)Utilities\bin\x86\fxc.exe" /nologo /T ps_2_0 /E PSColor /Vn g_psColor /Fh "$(IntDir)shaders\render_ps_color.h" "%(FullPath)" || exit /b 1
"$(DXSDKPath)Utilities\bin\x86\fxc.exe" /nologo /T ps_2_0 /E PSTexture /Vn g_psTexture /Fh "$(IntDir)shaders\render_ps_texture.h" "%(FullPath)" || exit /b 1
"$(DXSDKPath)Utilities\bin\x86\fxc.exe" /nologo /T ps_2_0 /E PSCopy /Vn g_psCopy /Fh "$(IntDir)shaders\render_ps_copy.h" "%(FullPath)" || exit /b 1
"$(DXSDKPath)Utilities\bin\x86\fxc.exe" /nologo /T ps_2_0 /E PSMeshColor /Vn g_psMeshColor /Fh "$(IntDir)shaders\render_ps_mesh_color.h" "%(FullPath)" || exit /b 1
"$(DXSDKPath)Utilities\bin\x86\fxc.exe" /nologo /T ps_2_0 /E PSMeshTexture /Vn g_psMeshTexture /Fh "$(IntDir)shaders\render_ps_mesh_texture.h" "%(FullPath)" || exit /b 1</Command>
      <Outputs>$(IntDir)shaders\render_vs.h;$(IntDir)shaders\render_vs_mesh.h;$(IntDir)shaders\render_ps_color.h;$(IntDir)shaders\render_ps_texture.h;$(IntDir)shaders\render_ps_copy.h;$(IntDir)shaders\render_ps_mesh_color.h;$(IntDir)shaders\render_ps_mesh_texture.h</Outputs>
    </CustomBuild>
  </ItemGroup>
