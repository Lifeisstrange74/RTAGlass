  <PropertyGroup>
    <!-- XP is the deliberate minimum target; silence MSB8051. -->
    <XPDeprecationWarning>false</XPDeprecationWarning>
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <!-- /permissive- breaks the Windows 7.1A SDK headers (objbase.h). -->
      <ConformanceMode>false</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(IntDir)shaders;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_WIN32_WINNT=0x0501;WINVER=0x0501;WIN32_LEAN_AND_MEAN;NOMINMAX;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Thread-safe statics rely on TLS that is unreliable on XP. -->
      <AdditionalOptions>/Zc:threadSafeInit- %(AdditionalOptions)</AdditionalOptions>
      <!-- The CPU floor, from build.py's arch option (or the property RTAGlassArch): SSE2 (the compiler's default), SSE or IA32 (x87,
           for CPUs before the Pentium 4). -->
      <EnableEnhancedInstructionSet Condition="'$(RTAGlassArch)'=='SSE'">StreamingSIMDExtensions</EnableEnhancedInstructionSet>
      <EnableEnhancedInstructionSet Condition="'$(RTAGlassArch)'=='IA32'">NoExtensions</EnableEnhancedInstructionSet>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>d3d9.lib;ole32.lib;shell32.lib;winmm.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
    <!-- The distribution folder: everything a player needs, in dist\RTAGlass (robocopy only copies
         changed data files, so this is quick after the first build). The textures, models and collision data
         go in packed, as data\textures.rpk, models.rpk and collision.rpk (tools/rpak, built first; each is
         repacked only when its folder has changed), and rpak.exe and adpconv.exe go in tools\ for
         modders. -->
    <PostBuildEvent>
      <Message>Assembling dist\RTAGlass</Message>
      <Command>set DIST=$(SolutionDir)dist\RTAGlass
if not exist "%DIST%" mkdir "%DIST%"
copy /Y "$(TargetPath)" "%DIST%\" &gt;nul || exit /b 1
copy /Y "$(ProjectDir)package\README.txt" "%DIST%\" &gt;nul || exit /b 1
robocopy "$(ProjectDir)data" "%DIST%\data" /MIR /XD "$(ProjectDir)data\textures" "$(ProjectDir)data\models" "$(ProjectDir)data\collision" /XF README.md *.rpk /NFL /NDL /NJH /NJS /NP &gt;nul
if errorlevel 8 exit /b 1
for %%F in (textures models collision) do (
  if exist "%DIST%\data\%%F" rmdir /s /q "%DIST%\data\%%F"
  "$(OutDir)rpak.exe" pack "$(ProjectDir)data\%%F" "%DIST%\data\%%F.rpk" --update || exit /b 1
)
if not exist "%DIST%\tools" mkdir "%DIST%\tools"
copy /Y "$(OutDir)rpak.exe" "%DIST%\tools\" &gt;nul || exit /b 1
copy /Y "$(OutDir)adpconv.exe" "%DIST%\tools\" &gt;nul || exit /b 1
exit /b 0</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
